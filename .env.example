# Tark AI - environment configuration TEMPLATE
# ------------------------------------------------------------------
# Copy this file to .env and edit the paths to match your machine:
#     cp .env.example .env
# All Spark / Hadoop / Hive install paths live here so they are NOT
# hardcoded in the Python code. executor.py loads .env automatically
# with python-dotenv.
# ------------------------------------------------------------------

# Java
JAVA_HOME=/path/to/java-8-openjdk

# Hadoop
HADOOP_HOME=/path/to/hadoop
HADOOP_INSTALL=${HADOOP_HOME}
HADOOP_COMMON_HOME=${HADOOP_HOME}
HADOOP_HDFS_HOME=${HADOOP_HOME}
HADOOP_MAPRED_HOME=${HADOOP_HOME}
HADOOP_YARN_HOME=${HADOOP_HOME}
HADOOP_COMMON_LIB_NATIVE_DIR=${HADOOP_HOME}/lib/native
HADOOP_OPTS=-Djava.library.path=${HADOOP_HOME}/lib/native

# Spark
SPARK_HOME=/path/to/spark
PYSPARK_PYTHON=python3
# Keep this as plain pyspark-shell. Do NOT add --packages here: that
# triggers a Maven download which crashes the JVM when offline.
PYSPARK_SUBMIT_ARGS=pyspark-shell

# Hive
HIVE_HOME=/path/to/hive
HIVE_CONF_DIR=${HIVE_HOME}/conf
