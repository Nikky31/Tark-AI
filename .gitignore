# ------------------------------------------------------------------
# Tark AI - files that should NOT be committed to git
# ------------------------------------------------------------------

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# Real environment file with machine-specific paths (keep .env.example)
.env

# Trained ML model - auto-regenerated by nlp/intent.py on first run
*.pkl

# Local working data: uploaded CSVs + generated quality reports
data/
*_quality_report.json

# Generated PDF reports
*.pdf

# Spark / Hadoop / Hive local artifacts
spark-warehouse/
metastore_db/
derby.log
*.crc
_SUCCESS

# OS / editor junk
.DS_Store
.idea/
.vscode/
